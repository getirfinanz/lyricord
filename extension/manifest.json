{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "1.8.0",
  "homepage_url": "https://github.com/getirfinanz/lyricord",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "author": "fare",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "notifications",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:48231/*",
    "https://music.youtube.com/*",
    "https://soundcloud.com/*",
    "https://open.spotify.com/*",
    "https://music.apple.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*",
        "https://soundcloud.com/*",
        "https://open.spotify.com/*",
        "https://music.apple.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.apple.com/*"
      ],
      "js": [
        "apple-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
